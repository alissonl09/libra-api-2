CREATE TABLE XXMCC.XCXP_GV_PONTO_CONTROLE (
    ID_PONTO_CONTROLE      NUMBER(15) NOT NULL,
    ID_PROCESSO            NUMBER(15) NOT NULL,
    NM_PERFIL              VARCHAR2(50),
    TP_PONTO               VARCHAR2(50) NOT NULL,
    DS_PONTO               VARCHAR2(50),
    NM_PONTO_CONTROLE      VARCHAR2(50) NOT NULL,
    NR_ORDEM_PROCESSO      NUMBER(15) NOT NULL,
    QT_TEMPO_MEDIO         NUMBER(15),
    IN_STATUS              VARCHAR2(1) NOT NULL,
    DT_PONTO_CONTROLE      DATE NOT NULL,
    DT_CRIACAO             DATE NOT NULL,
    NM_USUARIO_CRIACAO     VARCHAR2(100) NOT NULL,
    DT_ALTERACAO           DATE NOT NULL,
    NM_USUARIO_ALTERACAO   VARCHAR2(100) NOT NULL
);

ALTER TABLE XXMCC.XCXP_GV_PONTO_CONTROLE ADD CONSTRAINT XCXP_GV_PONTO_CONTROLE_PK PRIMARY KEY ( ID_PONTO_CONTROLE );

ALTER TABLE XXMCC.XCXP_GV_PONTO_CONTROLE ADD CONSTRAINT XCXP_GV_PONTO_CONTROLE_UK1 UNIQUE ( NM_PONTO_CONTROLE, NM_PERFIL, NR_ORDEM_PROCESSO, DT_PONTO_CONTROLE );

ALTER TABLE XXMCC.XCXP_GV_PONTO_CONTROLE ADD CONSTRAINT XCXP_GV_PONTOCONTR_PROCESSO_FK FOREIGN KEY ( ID_PROCESSO ) REFERENCES XXMCC.XCXP_GV_PROCESSO ( ID_PROCESSO );

PROMPT ADZ:  AD_ZD_TABLE.UPGRADE

BEGIN
  AD_ZD_TABLE.UPGRADE('XXMCC', 'XCXP_GV_PONTO_CONTROLE');
END;

