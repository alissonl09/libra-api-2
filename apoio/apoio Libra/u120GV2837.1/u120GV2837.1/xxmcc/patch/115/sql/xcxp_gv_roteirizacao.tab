CREATE TABLE XXMCC.XCXP_GV_ROTEIRIZACAO (
    ID_ROTEIRIZACAO        NUMBER(15) NOT NULL,
    ID_OPERACAO            NUMBER(15) NOT NULL,
    NM_ROTEIRIZACAO        VARCHAR2(100) NOT NULL,
    IN_STATUS              VARCHAR2(1) NOT NULL,
    DT_ROTEIRIZACAO        DATE NOT NULL,
    DT_CRIACAO             DATE NOT NULL,
    NM_USUARIO_CRIACAO     VARCHAR2(100) NOT NULL,
    DT_ALTERACAO           DATE NOT NULL,
    NM_USUARIO_ALTERACAO   VARCHAR2(100) NOT NULL
);

ALTER TABLE XXMCC.XCXP_GV_ROTEIRIZACAO ADD CONSTRAINT XCXP_GV_ROTEIRIZACAO_PK PRIMARY KEY ( ID_ROTEIRIZACAO );

ALTER TABLE XXMCC.XCXP_GV_ROTEIRIZACAO ADD CONSTRAINT XCXP_GV_ROTEIRIZACAO_UK1 UNIQUE ( NM_ROTEIRIZACAO, DT_ROTEIRIZACAO );

ALTER TABLE XXMCC.XCXP_GV_ROTEIRIZACAO ADD CONSTRAINT XCXP_GV_ROT_OPERACAO_FK FOREIGN KEY ( ID_OPERACAO ) REFERENCES XXMCC.XCXP_GV_OPERACAO ( ID_OPERACAO );

PROMPT ADZ:  AD_ZD_TABLE.UPGRADE

BEGIN
  AD_ZD_TABLE.UPGRADE('XXMCC', 'XCXP_GV_ROTEIRIZACAO');
END;

/
