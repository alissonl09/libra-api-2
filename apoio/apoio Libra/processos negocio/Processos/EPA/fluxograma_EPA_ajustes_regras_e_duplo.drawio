        <mxCell id="formula_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFCE8;strokeColor=#C9B458;strokeWidth=1.2;fontFamily=Arial;fontSize=12;fontColor=#374151;verticalAlign=top;spacing=8;" value="&lt;b&gt;Regra da transição BAG → GRANEL&lt;/b&gt;&lt;br&gt;&lt;b&gt;Peso N.F. do GRANEL &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;=&lt;/span&gt; Peso total previsto do EPA &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;–&lt;/span&gt; Quantidade efetivamente recebida em BAGs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ao pesquisar novamente a placa para iniciar a etapa GRANEL, os dados do EPA são carregados novamente e o Peso N.F. já representa somente a quantidade restante, pois a parcela recebida em BAGs já foi considerada no fechamento anterior." vertex="1">
          <mxGeometry height="165" width="900" x="18265" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="summary_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#334155;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" value="&lt;b&gt;REGRAS CONFORME ACONDICIONAMENTO&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="2060" x="20020" y="3615" as="geometry" />
        </mxCell>
        <mxCell id="summary_bag" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#4F7DB8;fontFamily=Arial;fontSize=12;fontColor=#294E7A;verticalAlign=top;spacing=10;" value="&lt;b&gt;BAG&lt;/b&gt;&lt;br&gt;• Peso recebido: balança de BAGs / WMS&lt;br&gt;• Peso de embalagem parametrizado é considerado&lt;br&gt;• Peso líquido rodoviário não é a referência final recebida&lt;br&gt;• &lt;b&gt;2 tickets&lt;/b&gt;" vertex="1">
          <mxGeometry height="185" width="650" x="20020" y="3670" as="geometry" />
        </mxCell>
        <mxCell id="summary_bulk" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F8EA;strokeColor=#6A8E3A;fontFamily=Arial;fontSize=12;fontColor=#476228;verticalAlign=top;spacing=10;" value="&lt;b&gt;GRANEL&lt;/b&gt;&lt;br&gt;• Não há pesagem individual no armazém&lt;br&gt;• Considera o Peso Líquido da balança rodoviária&lt;br&gt;• &lt;b&gt;1 ticket&lt;/b&gt;" vertex="1">
          <mxGeometry height="185" width="650" x="20685" y="3670" as="geometry" />
        </mxCell>
        <mxCell id="summary_dual" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF0FA;strokeColor=#A15C9D;fontFamily=Arial;fontSize=12;fontColor=#6E3E6B;verticalAlign=top;spacing=10;" value="&lt;b&gt;BAG + GRANEL&lt;/b&gt;&lt;br&gt;• Peso N.F. inicial = BAG + GRANEL&lt;br&gt;• BAG é processado primeiro e gera &lt;b&gt;2 tickets&lt;/b&gt;&lt;br&gt;• Depois abre-se nova etapa GRANEL com o saldo do EPA&lt;br&gt;• GRANEL segue sua regra e gera &lt;b&gt;1 ticket&lt;/b&gt;" vertex="1">
          <mxGeometry height="185" width="730" x="21350" y="3670" as="geometry" />
        </mxCell>
        <mxCell id="two_decisions" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#A6A6A6;strokeWidth=1.2;fontFamily=Arial;fontSize=12;fontColor=#374151;verticalAlign=top;spacing=8;" value="&lt;b&gt;Duas decisões diferentes&lt;/b&gt;&lt;br&gt;1) Documento de origem: Cooperado → RD | Terceiro → Nota Fiscal&lt;br&gt;2) Forma de acondicionamento: BAG | GRANEL | BAG + GRANEL" vertex="1">
          <mxGeometry height="105" width="720" x="120" y="3635" as="geometry" />
        </mxCell>
        <mxCell id="dual_sequence_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C97A40;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#7C3F16;verticalAlign=top;spacing=10;" value="&lt;b&gt;Sequência obrigatória no duplo acondicionamento&lt;/b&gt;&lt;br&gt;Abertura com carga total → BAG → fechamento BAG → nova etapa GRANEL → fechamento GRANEL → encerramento do EPA" vertex="1">
          <mxGeometry height="105" width="1150" x="880" y="3635" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#64748B;" value="Fluxograma de processo de negócio — EPA (Entrada de Produto Agrícola) • Elementos e conexões editáveis no draw.io / diagrams.net" vertex="1">
