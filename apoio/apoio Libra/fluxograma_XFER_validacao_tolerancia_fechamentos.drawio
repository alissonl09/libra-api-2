        </mxCell>
        <mxCell id="d_end" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;align=center;verticalAlign=middle;" value="&lt;b&gt;FIM&lt;/b&gt;&lt;br&gt;XFER BAG + GRANEL" vertex="1">
          <mxGeometry height="80" width="225" x="30920" y="3191" as="geometry" />
        </mxCell>
        <mxCell id="d_note_seq_d" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFCE8;strokeColor=#C9B458;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;DESTINO — ordem obrigatória&lt;/b&gt;&lt;br&gt;BAG: Ticket BAG → abrir → descarregar → fechar → &lt;b&gt;validar diferença BAG&lt;/b&gt; → concluir. Depois GRANEL: Ticket GRANEL → abrir → descarregar → fechar → &lt;b&gt;validar diferença GRANEL&lt;/b&gt; → concluir." vertex="1">
          <mxGeometry height="88" width="1600" x="21900" y="3037" as="geometry" />
        </mxCell>
        <mxCell id="summary_title" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#7B8794;strokeWidth=1.2;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=12;" value="RESUMO DAS REGRAS DE ACONDICIONAMENTO" vertex="1">
          <mxGeometry height="48" width="25250" x="6250" y="4250" as="geometry" />
        </mxCell>
        <mxCell id="sum_g" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;GRANEL&lt;/b&gt;&lt;br&gt;&lt;b&gt;Origem:&lt;/b&gt; veículo vazio → carregamento → fechamento. Peso apurado = carregado – tara; esperado = peso previsto; &lt;b&gt;validar tolerância antes de concluir&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Destino:&lt;/b&gt; veículo chega carregado → descarga → fechamento vazio; comparar o resultado com a respectiva pesagem da origem e &lt;b&gt;validar tolerância&lt;/b&gt;." vertex="1">
          <mxGeometry height="240" width="8150" x="6250" y="4310" as="geometry" />
        </mxCell>
        <mxCell id="sum_b" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;BAG&lt;/b&gt;&lt;br&gt;&lt;b&gt;Origem:&lt;/b&gt; após o fechamento, apurar Peso Líquido → &lt;b&gt;Previsto ajustado = produto + peso dos BAGs&lt;/b&gt; → comparar → &lt;b&gt;validar tolerância&lt;/b&gt;. Não descontar BAGs.&lt;br&gt;&lt;b&gt;Destino:&lt;/b&gt; descarregar/controlar BAGs → fechar → comparar com a referência BAG da origem → &lt;b&gt;validar tolerância&lt;/b&gt;." vertex="1">
          <mxGeometry height="240" width="8150" x="14550" y="4310" as="geometry" />
        </mxCell>
        <mxCell id="sum_d" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;BAG + GRANEL&lt;/b&gt;&lt;br&gt;BAG é processado primeiro e GRANEL depois. Cada parcela possui abertura, fechamento e &lt;b&gt;validação de tolerância próprios&lt;/b&gt;. São dois tickets na origem e duas validações no destino. &lt;b&gt;Nunca realizar uma única validação ao final da XFER.&lt;/b&gt;" vertex="1">
          <mxGeometry height="240" width="8650" x="22850" y="4310" as="geometry" />
        </mxCell>
