        <mxCell id="d_dest_data_note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFCE8;strokeColor=#C9B458;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#374151;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;DESTINO — BAG + GRANEL&lt;/b&gt;&lt;br&gt;&lt;b&gt;Etapa BAG:&lt;/b&gt; informar &lt;b&gt;Ticket BAG + Unidade de Origem&lt;/b&gt; → importar dados da pesagem BAG da origem → conferir/complementar → abrir a etapa BAG no destino.&lt;br&gt;&lt;b&gt;Etapa GRANEL:&lt;/b&gt; informar &lt;b&gt;Ticket GRANEL + Unidade de Origem&lt;/b&gt; → importar dados da pesagem GRANEL da origem → conferir/complementar → abrir a etapa GRANEL no destino.&lt;br&gt;&lt;b&gt;Não utilizar a placa como chave de busca no destino.&lt;/b&gt;" vertex="1">
