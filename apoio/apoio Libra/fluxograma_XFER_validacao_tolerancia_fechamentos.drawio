        <mxCell id="d_d23" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;fontStyle=0;" value="Registrar fechamento / salvar pesagem" vertex="1">
