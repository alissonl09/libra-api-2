        <mxCell id="d_d24" parent="1" style="shape=document;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#E1F3D8;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" value="Emitir ticket GRANEL no destino" vertex="1">
