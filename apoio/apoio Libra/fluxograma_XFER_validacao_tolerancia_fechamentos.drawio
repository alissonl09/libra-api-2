        <mxCell id="validation_global_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFCE8;strokeColor=#C9B458;strokeWidth=1.4;fontFamily=Arial;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;REGRA GERAL — VALIDAÇÃO EM TODO FECHAMENTO&lt;/b&gt;&lt;br&gt;Cada pesagem aberta possui &lt;b&gt;seu próprio fechamento e sua própria validação de tolerância&lt;/b&gt;.&lt;br&gt;&lt;b&gt;ORIGEM:&lt;/b&gt; apurar peso → determinar esperado conforme acondicionamento → comparar → validar tolerância. GRANEL: esperado = peso previsto do produto. BAG: esperado = produto + peso parametrizado dos BAGs.&lt;br&gt;&lt;b&gt;DESTINO:&lt;/b&gt; apurar resultado recebido → comparar com a referência da respectiva pesagem da origem → validar tolerância.&lt;br&gt;&lt;b&gt;BAG + GRANEL:&lt;/b&gt; validar BAG e GRANEL separadamente; nunca fazer uma única validação no final da transferência." vertex="1">
          <mxGeometry height="165" width="4900" x="600" y="155" as="geometry" />
        </mxCell>
